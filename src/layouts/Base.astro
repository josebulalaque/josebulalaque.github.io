---
import '../styles/global.css';
import { site, sections } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
}

const { title, description = site.description, type = 'website' } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name}, ${site.role.toLowerCase()}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: site.url,
  sameAs: Object.values(site.links).filter(Boolean),
};
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: writing`} href="/rss.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary" />

    <meta name="theme-color" content="#eceef0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16191d" media="(prefers-color-scheme: dark)" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />

    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header wrap">
      <a class="site-name" href="/">{site.name}</a>
      <nav aria-label="Main">
        <ul>
          {
            sections.slice(1).map((s) => (
              <li>
                <a
                  href={s.href}
                  aria-current={path.startsWith(s.href) ? 'page' : undefined}
                >
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
        <button class="theme-toggle" type="button" aria-label="Switch colour theme">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor" />
          </svg>
        </button>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer wrap">
      <p>
        <a href={site.links.github}>GitHub</a>
        {site.links.linkedin && <a href={site.links.linkedin}>LinkedIn</a>}
        <a href="/rss.xml">RSS feed</a>
      </p>
      <p class="muted">Built with Astro and hosted on GitHub Pages.</p>
    </footer>

    <script is:inline>
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const current =
          root.dataset.theme ??
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
  }

  .site-name {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 750;
    font-size: 1.2rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  nav ul {
    display: flex;
    gap: clamp(0.25rem, 1.5vw, 0.75rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: block;
    color: var(--ink);
    text-decoration: none;
    padding: 0.15rem 0.45rem;
    border-radius: 2px;
  }

  nav a:hover {
    background: var(--surface);
  }

  /* The current page gets a strip of label tape. */
  nav a[aria-current='page'] {
    background: var(--tape);
    color: var(--tape-ink);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-left: 0.25rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--ink);
    background: var(--surface);
  }

  .site-footer {
    margin-top: 5rem;
    padding-block: 2rem 3rem;
    border-top: 1px solid var(--rule);
    font-size: 0.95rem;
  }

  .site-footer p {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin: 0 0 0.5rem;
  }

  @media (max-width: 30rem) {
    .site-header {
      flex-wrap: wrap;
    }

    nav {
      margin-left: -0.45rem;
    }
  }

  @media print {
    .site-header,
    .site-footer,
    .skip-link {
      display: none;
    }
  }
</style>
