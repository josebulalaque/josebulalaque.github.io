---
import { sections } from '../data/site';

// Rack units are counted from the bottom, so the top server sits in the highest U.
const units = sections.map((s, i) => ({ ...s, u: sections.length - i, i }));
---

<nav class="rack" aria-label="Sections">
  <ul>
    {
      units.map((s) => (
        <li style={`--i: ${s.i}`}>
          <span class="u" aria-hidden="true">
            U{s.u}
          </span>
          <a href={s.href} class="server">
            <span class="ear" aria-hidden="true" />
            <span class="plate">
              <span class="tape label">{s.label}</span>
            </span>
            <span class="vent" aria-hidden="true" />
            <span class="bays" aria-hidden="true">
              {[0, 1, 2, 3].map((b) => (
                <span class="bay" style={`--b: ${b}`} />
              ))}
            </span>
            <span class="leds" aria-hidden="true">
              <span class="led power" />
              <span class="led uid" />
            </span>
            <span class="ear" aria-hidden="true" />
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .rack {
    background: var(--steel-lo);
    border-radius: 6px;
    padding: 0.6rem clamp(0.4rem, 1.5vw, 0.75rem);
  }

  ul {
    display: grid;
    gap: 3px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    align-items: center;
  }

  /* The rack rail: unit numbers beside a strip of square cage-nut holes. */
  .u {
    align-self: stretch;
    display: grid;
    place-items: center;
    font-size: 0.75rem;
    font-weight: 600;
    color: #aab2bd;
    background:
      linear-gradient(var(--steel-lo), var(--steel-lo)) right / 2px 100% no-repeat,
      var(--rail);
  }

  .server {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 1.25rem);
    min-height: clamp(3.5rem, 8.5vw, 5.75rem);
    padding-inline: 0;
    background: linear-gradient(var(--steel-hi), var(--steel) 18%, var(--steel) 85%, var(--steel-lo));
    color: var(--tape-ink);
    text-decoration: none;
    border-radius: 2px;
  }

  .server:focus-visible {
    outline: 3px solid var(--led-uid);
    outline-offset: 2px;
  }

  /* Rack ears with their thumbscrews. */
  .ear {
    flex: none;
    align-self: stretch;
    width: 1.1rem;
    background:
      radial-gradient(circle, #8b939e 0 3px, #555b64 3.5px 4.5px, transparent 5px) center / 100% 100% no-repeat,
      #262a30;
  }

  /* A fixed-width spot for the label, so every vent lines up like matching chassis. */
  .plate {
    flex: none;
    width: clamp(5.5rem, 13vw, 7.25rem);
  }

  .label {
    font-size: clamp(0.95rem, 2.4vw, 1.15rem);
    transform: rotate(-0.8deg);
  }

  li:nth-child(even) .label {
    transform: rotate(0.6deg);
  }

  .vent {
    flex: 1;
    align-self: stretch;
    margin-block: 0.7rem;
    border-radius: 2px;
    background: radial-gradient(circle, var(--mesh) 1.7px, transparent 2px) 0 0 / 7px 7px, #3a3f47;
  }

  .bays {
    display: flex;
    gap: 3px;
    align-self: stretch;
    padding-block: 0.55rem;
  }

  /* Hot-swap drive caddies, each with its activity light near the top. */
  .bay {
    position: relative;
    width: 1.35rem;
    border-radius: 2px;
    background:
      repeating-linear-gradient(90deg, #1b1e22 0 2px, #2c3036 2px 4px) center 65% / 70% 45% no-repeat,
      #3e434b;
    box-shadow: inset 0 0 0 1px #00000059;
  }

  .bay::before {
    content: '';
    position: absolute;
    top: 18%;
    left: 50%;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--led-off);
  }

  .leds {
    display: grid;
    gap: 0.45rem;
  }

  .led {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--led-off);
  }

  /* Power-on self test: amber while it checks, then green, one server after another. */
  .power {
    animation: post 1.1s calc(0.3s + var(--i) * 0.3s) both;
  }

  @keyframes post {
    0% { background: var(--led-off); }
    15%, 70% { background: var(--led-activity); box-shadow: 0 0 6px var(--led-activity); }
    100% { background: var(--led-power); box-shadow: 0 0 6px var(--led-power); }
  }

  /* Hovering a server switches on its identify light, the way you'd find a box in a full rack. */
  .server:hover .uid,
  .server:focus-visible .uid {
    background: var(--led-uid);
    box-shadow: 0 0 8px var(--led-uid);
  }

  .server:hover .bay::before,
  .server:focus-visible .bay::before {
    animation: io 0.5s calc(var(--b) * 0.11s) steps(2) infinite;
  }

  @keyframes io {
    0% { background: var(--led-power); }
    100% { background: var(--led-off); }
  }

  @media (max-width: 40rem) {
    .bay:nth-child(n + 3) {
      display: none;
    }
  }

  @media (max-width: 26rem) {
    li {
      grid-template-columns: 1.9rem 1fr;
    }

    .bays {
      display: none;
    }

    .ear {
      width: 0.8rem;
    }
  }
</style>
