---
import { sections } from '../data/site';
---

<nav class="panel" aria-label="Sections">
  <span class="screw" aria-hidden="true"></span>
  <ol>
    {
      sections.map((s, i) => (
        <li data-color={s.color} style={`--i: ${i}`}>
          <a href={s.href}>
            <span class="status" aria-hidden="true">
              <span class="num">{i + 1}</span>
              <span class="led" />
            </span>
            <span class="jack" aria-hidden="true" />
            <span class="label">{s.label}</span>
            <span class="lead cable" aria-hidden="true" />
          </a>
        </li>
      ))
    }
  </ol>
  <span class="screw" aria-hidden="true"></span>
</nav>

<style>
  .panel {
    display: flex;
    align-items: flex-start;
    gap: clamp(0.5rem, 2vw, 1.25rem);
    background: var(--panel);
    border-top: 1px solid var(--panel-edge);
    border-bottom: 1px solid #0006;
    border-radius: 4px;
    padding: 1rem clamp(0.6rem, 2vw, 1.25rem) 0;
    box-shadow: inset 0 1px 0 #ffffff14;
  }

  .screw {
    flex: none;
    width: 0.7rem;
    height: 0.7rem;
    margin-top: 1.9rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #8794a8, #4a5568 70%);
  }

  ol {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(0.5rem, 2.5vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    display: grid;
    justify-items: center;
    row-gap: 0.4rem;
    color: var(--panel-label);
    text-decoration: none;
    border-radius: 3px;
  }

  a:focus-visible {
    outline-color: var(--c);
    outline-offset: 4px;
  }

  .status {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: min(100%, 4.5rem);
  }

  .num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1;
  }

  .led {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--led-off);
    animation: negotiate 0.9s calc(0.35s + var(--i) * 0.22s) steps(1) both;
  }

  /* The RJ45 socket: a rectangle with the clip notch cut out of its lower edge. */
  .jack {
    width: min(100%, 4.5rem);
    aspect-ratio: 1.15;
    background: var(--port);
    clip-path: polygon(0 0, 100% 0, 100% 72%, 72% 72%, 72% 100%, 28% 100%, 28% 72%, 0 72%);
    box-shadow: inset 0 3px 0 #0008;
    position: relative;
  }

  .jack::before {
    content: '';
    position: absolute;
    inset: 12% 14% auto;
    height: 14%;
    background: repeating-linear-gradient(90deg, #b9a46a 0 2px, transparent 2px 5px);
    opacity: 0.55;
  }

  .label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.05rem, 3vw, 1.4rem);
    line-height: 1.1;
    color: #eef2f7;
  }

  /* A short run of cable hanging from each port. */
  .lead {
    width: 0.8rem;
    height: 2.25rem;
    margin-top: 0.15rem;
    background: repeating-linear-gradient(
      -35deg,
      var(--c) 0 9px,
      var(--stripe) 9px 13px
    );
    border-radius: 0 0 3px 3px;
    transform-origin: top;
    transition: height 0.2s ease-out;
  }

  a:hover .lead,
  a:focus-visible .lead {
    height: 3rem;
  }

  a:hover .led,
  a:focus-visible .led {
    background: var(--c);
    box-shadow: 0 0 8px var(--c);
  }

  /* One link-negotiation blink per port on load, then the LEDs settle lit. */
  @keyframes negotiate {
    0% { background: var(--led-off); }
    20% { background: var(--c); }
    40% { background: var(--led-off); }
    60%, 100% { background: var(--c); box-shadow: 0 0 6px var(--c); }
  }

  @media (max-width: 26rem) {
    .screw {
      display: none;
    }
  }
</style>
