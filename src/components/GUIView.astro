---
import { PORTFOLIO_DATA, getSocialLinks, certDate } from "../data/portfolio";
import Neofetch from "./Neofetch.astro";
import SpotifyWidget from "./SpotifyWidget.astro";
import GamesWidget from "./GamesWidget.astro";
import ContributionChart from "./ContributionChart.astro";

const { developer, skills, collabs, certifications, education } = PORTFOLIO_DATA;
const socialLinks = getSocialLinks();
const githubUser = developer.github.match(/github\.com\/([\w-]+)/i)?.[1] ?? developer.handle;
---

<div
  id="view-gui"
  class="hidden flex flex-col space-y-6 font-mono text-xs md:text-sm"
>
  <!-- Top Neofetch System Summary Card -->
  <Neofetch />

  <!-- Main TUI Grid: Sidebar Directory Navigation + Main Panel -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Sidebar Navigation Tree -->
    <aside
      class="lg:col-span-3 border border-[var(--border-color)] bg-[var(--bg-card)] p-4 space-y-4"
    >
      <div
        class="text-[var(--accent)] font-bold border-b border-[var(--border-color)] pb-2 flex items-center justify-between"
      >
        <span>📁 EXPLORER</span>
        <span class="text-[10px] text-[var(--fg-dim)]">CONTENTS</span>
      </div>

      <nav class="space-y-1 font-mono text-xs">
        <a
          href="#gui-about"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-[var(--fg-bright)] font-bold transition-colors"
        >
          <span class="text-yellow-400">📄</span> bio.txt (About Me)
        </a>
        <a
          href="#gui-skills"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-[var(--fg-bright)] transition-colors"
        >
          <span class="text-emerald-400">⚙️</span> skills.sh (Skills)
        </a>
        <a
          href="#gui-collabs"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-[var(--fg-bright)] transition-colors"
        >
          <span class="text-purple-400">💼</span> experience.md (Experience)
        </a>
        <a
          href="#gui-certs"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-[var(--fg-bright)] transition-colors"
        >
          <span class="text-orange-400">🎓</span> certs.txt (Certifications)
        </a>
        <a
          href="#gui-github"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-[var(--fg-bright)] transition-colors"
        >
          <span class="text-sky-400">🐙</span> github.sh (Contributions)
        </a>
        <a
          href="#gui-contact"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-[var(--fg-bright)] transition-colors"
        >
          <span class="text-red-400">✉️</span> contact.txt (Contact)
        </a>
        <button
          type="button"
          id="gui-launch-pong"
          class="w-full text-left gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-[var(--accent)] font-bold transition-colors cursor-pointer border border-dashed border-[var(--border-color)] mt-1"
        >
          <span>🕹️</span> pong.sh (Pong Arcade)
        </button>
        <button
          type="button"
          id="gui-launch-snake"
          class="w-full text-left gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-emerald-400 font-bold transition-colors cursor-pointer border border-dashed border-[var(--border-color)] mt-1"
        >
          <span>🐍</span> snake.sh (Snake Arcade)
        </button>
        <button
          type="button"
          id="gui-launch-radio"
          class="w-full text-left gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-pink-400 font-bold transition-colors cursor-pointer border border-dashed border-[var(--border-color)] mt-1"
        >
          <span>📻</span> radio.sh (Lo-Fi Radio)
        </button>
      </nav>

      <!-- Spotify Activity Widget -->
      <SpotifyWidget />

      <!-- Games Activity Widget -->
      <GamesWidget />

      <!-- Quick Metrics -->
      <div
        class="pt-4 border-t border-[var(--border-color)] space-y-2 text-[11px]"
      >
        <div
          class="text-[var(--fg-dim)] font-bold uppercase tracking-wider text-[10px]"
        >
          CONTENT SPEC
        </div>
        <div class="flex justify-between text-[var(--fg-main)]">
          <span>Roles Held:</span>
          <span class="font-bold text-[var(--fg-bright)]">{collabs.length}</span
          >
        </div>
        <div class="flex justify-between text-[var(--fg-main)]">
          <span>Skill Domains:</span>
          <span class="font-bold text-yellow-400">{skills.length}</span>
        </div>
        <div class="flex justify-between text-[var(--fg-main)]">
          <span>Experience:</span>
          <span class="font-bold text-emerald-400">{developer.experience}</span>
        </div>
      </div>

      <!-- Quick GitHub Link -->
      <div class="pt-2">
        <a
          href={developer.github}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full text-center block px-3 py-1.5 border border-[var(--border-color)] bg-[var(--bg-main)] hover:border-[var(--border-active)] text-[var(--fg-bright)] text-xs font-bold transition-colors"
        >
          GitHub Profile ↗
        </a>
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="lg:col-span-9 space-y-8">
      <!-- Section 1: About Me -->
      <section
        id="gui-about"
        class="border border-[var(--border-color)] bg-[var(--bg-card)] p-4 sm:p-5 space-y-4"
      >
        <div
          class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-2 border-b border-[var(--border-color)] pb-3"
        >
          <h2
            class="text-xs sm:text-base font-bold text-[var(--fg-bright)] flex items-center gap-1.5 sm:gap-2 truncate"
          >
            <span class="text-[var(--accent)]">></span> CAT BIO.TXT // ABOUT ME
          </h2>
          <span class="text-[10px] sm:text-xs text-[var(--fg-dim)] shrink-0">[READ-ONLY]</span>
        </div>

        <p class="text-[var(--fg-main)] leading-relaxed text-xs sm:text-sm">
          {developer.bio}
        </p>

        {
          developer.quote && (
            <blockquote class="p-3 border-l-2 border-[var(--accent)] bg-[var(--bg-main)] text-[var(--fg-dim)] italic text-xs leading-relaxed">
              {developer.quote}
            </blockquote>
          )
        }

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
          <div
            class="p-3 border border-[var(--border-color)] bg-[var(--bg-main)] space-y-1"
          >
            <span class="text-[10px] text-[var(--fg-dim)] uppercase font-bold"
              >ENGINEERING FOCUS</span
            >
            <div class="text-xs text-[var(--accent)] font-bold">
              {developer.focus}
            </div>
          </div>
          <div
            class="p-3 border border-[var(--border-color)] bg-[var(--bg-main)] space-y-1"
          >
            <span class="text-[10px] text-[var(--fg-dim)] uppercase font-bold"
              >LOCATION</span
            >
            <div class="text-xs text-[var(--fg-bright)] font-bold">
              📍 {developer.location}
            </div>
          </div>
        </div>
      </section>

      <!-- Section 2: Skills -->
      <section
        id="gui-skills"
        class="border border-[var(--border-color)] bg-[var(--bg-card)] p-4 sm:p-5 space-y-4"
      >
        <div
          class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-2 border-b border-[var(--border-color)] pb-3"
        >
          <h2
            class="text-xs sm:text-base font-bold text-[var(--fg-bright)] flex items-center gap-1.5 sm:gap-2 truncate"
          >
            <span class="text-[var(--accent)]">></span> ./SKILLS.SH // TECHNICAL PROFICIENCY
          </h2>
          <span class="text-[10px] sm:text-xs text-[var(--fg-dim)] shrink-0">[PROFICIENCY METRICS]</span
          >
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {
            skills.map((cat) => (
              <div class="border border-[var(--border-color)] bg-[var(--bg-main)] p-4 space-y-3">
                <div class="text-xs font-bold text-[var(--accent)] flex items-center gap-2 border-b border-[var(--border-color)] pb-2">
                  <span>{cat.icon}</span>
                  <span>{cat.category}</span>
                </div>

                <div class="space-y-2.5">
                  {cat.skills.map((skill) => {
                    const filledCount = Math.round(skill.level / 10);
                    const barStr =
                      "█".repeat(filledCount) + "░".repeat(10 - filledCount);
                    return (
                      <div class="space-y-1">
                        <div class="flex justify-between text-xs font-bold">
                          <span class="text-[var(--fg-bright)]">
                            {skill.name}
                          </span>
                          <span class="text-[var(--fg-dim)] text-[10px]">
                            {skill.experience}
                          </span>
                        </div>
                        <div class="flex items-center gap-2 text-xs">
                          <div class="flex-1 bg-[var(--bg-card)] border border-[var(--border-color)] h-4 overflow-hidden relative flex items-center px-1">
                            <div
                              class="h-full bg-[var(--fg-dim)] opacity-40 absolute left-0 top-0"
                              style={`width: ${skill.level}%`}
                            />
                            <span class="relative z-10 text-[10px] text-[var(--fg-bright)] font-mono">
                              {barStr} {skill.level}%
                            </span>
                          </div>
                          <span class="text-[9px] px-1 bg-[var(--border-color)] text-[var(--accent)] font-bold">
                            {skill.tag}
                          </span>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Section 3: Work experience -->
      <section
        id="gui-collabs"
        class="border border-[var(--border-color)] bg-[var(--bg-card)] p-4 sm:p-5 space-y-4"
      >
        <div
          class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-2 border-b border-[var(--border-color)] pb-3"
        >
          <h2
            class="text-xs sm:text-base font-bold text-[var(--fg-bright)] flex items-center gap-1.5 sm:gap-2 truncate"
          >
            <span class="text-[var(--accent)]">></span> CAT EXPERIENCE.MD // WORK EXPERIENCE
          </h2>
          <span class="text-[10px] sm:text-xs text-[var(--fg-dim)] shrink-0">[CAREER LOG]</span>
        </div>

        <div class="space-y-4">
          {
            collabs.map((item) => (
              <div class="border border-[var(--border-color)] bg-[var(--bg-main)] p-5 space-y-3 hover:border-[var(--border-active)] transition-all">
                <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--border-color)] pb-2">
                  <h3 class="text-sm font-bold text-[var(--fg-bright)] flex items-center gap-2">
                    <span>💼</span> {item.title}
                  </h3>
                  <span class="text-[10px] px-2 py-0.5 border border-[var(--border-color)] text-[var(--accent)] uppercase font-bold">
                    {item.period}
                  </span>
                </div>

                {item.asciiLogo && (
                  <pre class="my-2 p-2.5 bg-[var(--bg-card)] text-[10px] sm:text-xs text-[var(--fg-bright)] overflow-x-auto leading-tight select-none border border-[var(--border-color)] font-mono whitespace-pre">{item.asciiLogo}</pre>
                )}

                {item.partner && (
                  <div class="text-xs text-[var(--fg-bright)] font-bold">{item.partner}</div>
                )}

                <p class="text-xs text-[var(--fg-main)] leading-relaxed">
                  {item.description}
                </p>

                <div class="space-y-1 pt-1">
                  <span class="text-[10px] text-[var(--fg-dim)] uppercase font-bold">
                    Key Contributions:
                  </span>
                  <ul class="list-disc list-inside text-xs text-[var(--fg-main)] space-y-0.5">
                    {item.contributions.map((c) => (
                      <li>{c}</li>
                    ))}
                  </ul>
                </div>

                <div class="flex flex-wrap items-center justify-between pt-3 border-t border-[var(--border-color)] gap-2">
                  <div class="flex flex-wrap gap-1">
                    {item.techStack.map((t) => (
                      <span class="text-[10px] px-1.5 py-0.5 bg-[var(--bg-card)] text-[var(--fg-dim)] border border-[var(--border-color)]">
                        {t}
                      </span>
                    ))}
                  </div>

                  {item.link && (
                    <a
                      href={item.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-xs text-[var(--accent)] hover:underline font-bold"
                    >
                      View Project ↗
                    </a>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Section 3b: Certifications & education -->
      <section
        id="gui-certs"
        class="border border-[var(--border-color)] bg-[var(--bg-card)] p-4 sm:p-5 space-y-4"
      >
        <div
          class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-2 border-b border-[var(--border-color)] pb-3"
        >
          <h2
            class="text-xs sm:text-base font-bold text-[var(--fg-bright)] flex items-center gap-1.5 sm:gap-2 truncate"
          >
            <span class="text-[var(--accent)]">></span> CAT CERTS.TXT // CERTIFICATIONS
          </h2>
          <span class="text-[10px] sm:text-xs text-[var(--fg-dim)] shrink-0">[{certifications.length} EARNED]</span>
        </div>

        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {
            certifications.map((c) => (
              <li class="border border-[var(--border-color)] bg-[var(--bg-main)] p-3 space-y-1 hover:border-[var(--border-active)] transition-colors">
                <div class="flex items-start justify-between gap-2">
                  <span class="text-xs font-bold text-[var(--fg-bright)]">{c.name}</span>
                  <span class="text-[10px] text-[var(--accent)] font-bold shrink-0">{certDate(c)}</span>
                </div>
                <div class="text-[10px] text-[var(--fg-dim)]">
                  {c.issuer}
                  {c.code && <span> // {c.code}</span>}
                </div>
              </li>
            ))
          }
        </ul>

        <div class="space-y-2 pt-2">
          <div class="text-[10px] text-[var(--fg-dim)] font-bold uppercase tracking-wider">Education</div>
          <ul class="space-y-1.5 text-xs">
            {
              education.map((e) => (
                <li class="flex flex-wrap items-center justify-between gap-1 border-b border-[var(--border-color)]/40 pb-1.5">
                  <span>
                    <span class="text-[var(--fg-bright)] font-bold">{e.name}</span>
                    <span class="text-[var(--fg-dim)]"> // {e.school}</span>
                  </span>
                  <span class="text-[var(--accent)] font-bold">{e.year}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- Section 4: GitHub contribution chart -->
      <section
        id="gui-github"
        class="border border-[var(--border-color)] bg-[var(--bg-card)] p-4 sm:p-5 space-y-4"
      >
        <div
          class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-2 border-b border-[var(--border-color)] pb-3"
        >
          <h2
            class="text-xs sm:text-base font-bold text-[var(--fg-bright)] flex items-center gap-1.5 sm:gap-2 truncate"
          >
            <span class="text-[var(--accent)]">></span> CAT GITHUB.SH // CONTRIBUTIONS
          </h2>
          <span class="text-[10px] sm:text-xs text-[var(--fg-dim)] shrink-0">[LAST 12 MONTHS]</span>
        </div>

        <ContributionChart username={githubUser} profileUrl={developer.github} />
      </section>

      <!-- Section 5: Contact -->
      <section
        id="gui-contact"
        class="border border-[var(--border-color)] bg-[var(--bg-card)] p-4 sm:p-5 space-y-4"
      >
        <div
          class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-2 border-b border-[var(--border-color)] pb-3"
        >
          <h2
            class="text-xs sm:text-base font-bold text-[var(--fg-bright)] flex items-center gap-1.5 sm:gap-2 truncate"
          >
            <span class="text-[var(--accent)]">></span> CONTACT // LINKS
          </h2>
          <span class="text-[10px] sm:text-xs text-[var(--fg-dim)] shrink-0">[REACH ME]</span>
        </div>

        <ul class="space-y-2 text-xs">
          {
            socialLinks.map((l) => (
              <li class="flex items-center justify-between flex-wrap gap-1 border-b border-[var(--border-color)]/40 pb-1.5">
                <span class="text-[var(--fg-dim)] font-bold">{l.icon} {l.label}:</span>
                <a
                  href={l.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sky-400 font-bold hover:underline break-all"
                >
                  {l.url.replace(/^https?:\/\//, "")} ↗
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</div>

<script>
  import { playSuccessSound } from "../utils/sound";

  document.addEventListener("DOMContentLoaded", () => {
    const bindLaunchBtn = (id: string, callback: () => void) => {
      const el = document.getElementById(id);
      if (!el) return;
      let lastTrigger = 0;
      const handler = () => {
        const now = Date.now();
        if (now - lastTrigger < 300) return; // Prevent double trigger
        lastTrigger = now;
        callback();
      };
      el.addEventListener("click", handler);
      el.addEventListener("touchstart", (e) => {
        e.preventDefault();
        handler();
      }, { passive: false });
    };

    bindLaunchBtn("gui-launch-pong", () => {
      const win = window as unknown as { togglePong?: (f?: boolean) => void };
      if (win.togglePong) {
        win.togglePong(true);
        playSuccessSound();
      }
    });

    bindLaunchBtn("gui-launch-snake", () => {
      const win = window as unknown as { toggleSnake?: (f?: boolean) => void };
      if (win.toggleSnake) {
        win.toggleSnake(true);
        playSuccessSound();
      }
    });

    bindLaunchBtn("gui-launch-radio", () => {
      const win = window as unknown as { radioEngine?: { toggleModal: (f?: boolean) => void } };
      if (win.radioEngine) {
        win.radioEngine.toggleModal(true);
        playSuccessSound();
      }
    });
  });
</script>
