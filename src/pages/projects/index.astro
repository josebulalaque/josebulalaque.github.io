---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { getProjects, formatDate } from '../../lib/content';

const projects = await getProjects();
---

<Base title="Projects" description={`Projects by ${site.name}.`}>
  <div class="wrap">
    <header class="page-head">
      <h1>Projects</h1>
      <p>Server builds, automation and tools I've made to keep systems running.</p>
    </header>

    {
      projects.length === 0 ? (
        <div class="pending">
          <span class="blank" aria-hidden="true" />
          <div>
            <h2>In progress</h2>
            <p>
              Write-ups are being prepared. Until they're up, my public code is on{' '}
              <a href={site.links.github}>GitHub</a>.
            </p>
          </div>
        </div>
      ) : (
        <ul class="projects">
          {projects.map((p) => (
            <li>
              <h2>{p.data.title}</h2>
              <p class="muted">{formatDate(p.data.date)}</p>
              <p>{p.data.summary}</p>
              <p class="links">
                {p.data.url && <a href={p.data.url}>Visit</a>}
                {p.data.repo && <a href={p.data.repo}>Source code</a>}
              </p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>

<style>
  .pending {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    max-width: 40rem;
    padding: 1.5rem;
    border: 2px dashed var(--rule);
    border-radius: 6px;
  }

  /* A blanking panel: rack space reserved, nothing mounted yet. */
  .blank {
    flex: none;
    width: 6rem;
    height: 2.25rem;
    border-radius: 2px;
    background:
      radial-gradient(circle, #8b939e 0 2.5px, transparent 3px) 0.45rem center / 0.5rem 0.5rem no-repeat,
      radial-gradient(circle, #8b939e 0 2.5px, transparent 3px) calc(100% - 0.45rem) center / 0.5rem 0.5rem no-repeat,
      var(--steel);
  }

  .pending h2 {
    margin: 0 0 0.4rem;
    font-size: 1.4rem;
  }

  .pending p {
    margin: 0;
  }

  .projects {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: var(--measure);
  }

  .projects li {
    padding-block: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .projects h2 {
    margin: 0 0 0.25rem;
    font-size: 1.5rem;
  }

  .links {
    display: flex;
    gap: 1.25rem;
    margin: 0;
  }

  @media (max-width: 30rem) {
    .pending {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
