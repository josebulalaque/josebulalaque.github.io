---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { cv } from '../data/cv';
---

<Base title="CV" description={`CV of ${site.name}, ${site.role.toLowerCase()}.`} section="brown">
  <div class="wrap cv" data-color="brown">
    <header class="page-head">
      <h1>CV</h1>
      <p class="print-only contact">
        {site.name}, {site.url.replace('https://', '')}
      </p>
      <p>{cv.summary}</p>
      <button class="print" type="button">Print or save as PDF</button>
    </header>

    <section>
      <h2>Experience</h2>
      <ol class="timeline">
        {
          cv.experience.map((job) => (
            <li>
              <p class="when">
                {job.start} to {job.end}
              </p>
              <h3>{job.role}</h3>
              <p class="org">{job.org}</p>
              <ul>
                {job.points.map((pt) => (
                  <li>{pt}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <section>
      <h2>Skills</h2>
      <dl class="skills">
        {
          cv.skills.map((s) => (
            <div>
              <dt>{s.group}</dt>
              <dd>{s.items.join(', ')}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    {
      cv.certifications.length > 0 && (
        <section>
          <h2>Certifications</h2>
          <ul class="plain">
            {cv.certifications.map((c) => (
              <li>
                <strong>{c.name}</strong>, {c.issuer}, {c.year}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      cv.education.length > 0 && (
        <section>
          <h2>Education</h2>
          <ul class="plain">
            {cv.education.map((e) => (
              <li>
                <strong>{e.name}</strong>, {e.org}, {e.year}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>

<script is:inline>
  document.querySelector('.print')?.addEventListener('click', () => window.print());
</script>

<style>
  .cv > * {
    max-width: var(--measure);
  }

  .print {
    margin-top: 1.5rem;
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 0.55rem 1rem;
    cursor: pointer;
  }

  .print:hover {
    border-color: var(--c);
  }

  /* Jobs run in order along a brown cable. */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.5rem;
    border-left: 4px solid var(--c);
  }

  .timeline > li {
    position: relative;
    padding-bottom: 1.75rem;
  }

  .timeline > li::before {
    content: '';
    position: absolute;
    left: calc(-1.5rem - 8px);
    top: 0.45rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 3px solid var(--c);
  }

  .when {
    margin: 0;
    font-size: 0.95rem;
    color: var(--muted);
  }

  .timeline h3 {
    margin: 0.15rem 0 0;
  }

  .org {
    margin: 0.15rem 0 0.6rem;
    color: var(--c-text);
    font-weight: 600;
  }

  .timeline ul {
    padding-left: 1.2rem;
    margin: 0;
  }

  .skills {
    margin: 0;
  }

  .skills div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding-block: 0.6rem;
    border-top: 1px solid var(--rule);
  }

  .skills dt {
    font-weight: 700;
  }

  .skills dd {
    margin: 0;
  }

  .plain {
    list-style: none;
    padding: 0;
  }

  .print-only {
    display: none;
  }

  @media (max-width: 30rem) {
    .skills div {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }

  @media print {
    :global(:root) {
      --bg: #fff;
      --ink: #000;
      --muted: #333;
      --rule: #bbb;
      --c: #555;
      --c-text: #000;
    }

    :global(body) {
      font-size: 10.5pt;
      line-height: 1.45;
    }

    .cv {
      margin: 0;
      max-width: none;
      padding: 0;
    }

    .page-head {
      padding: 0 0 0.5rem;
    }

    h1 {
      font-size: 30pt;
    }

    h2 {
      font-size: 16pt;
      margin-block: 1.2rem 0.5rem;
    }

    .print {
      display: none;
    }

    .print-only {
      display: block;
    }

    .timeline > li {
      break-inside: avoid;
      padding-bottom: 0.9rem;
    }
  }
</style>
