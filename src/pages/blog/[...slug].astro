---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, readingTime } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, tags } = post.data;
---

<Base title={title} description={description} section="blue" type="article">
  <article class="wrap">
    <header class="page-head">
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span>{readingTime(post.body)}</span>
        {updated && <span>Updated {formatDate(updated)}</span>}
      </p>
      {tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {tags.map((t) => <li>{t}</li>)}
        </ul>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    <p class="back"><a href="/blog/">All writing</a></p>
  </article>
</Base>

<style>
  h1 {
    font-size: clamp(2.6rem, 7vw, 4.75rem);
    max-width: 18ch;
  }

  .page-head .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    font-size: 1rem;
    margin-bottom: 1rem;
  }

  .back {
    margin-top: 3rem;
  }
</style>
